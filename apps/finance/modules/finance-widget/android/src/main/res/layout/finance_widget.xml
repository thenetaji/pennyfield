<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/finance_widget_background"
  android:orientation="vertical"
  android:padding="14dp">

  <TextView
    android:id="@+id/finance_widget_label"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textColor="#B3FFFFFF"
    android:textSize="12sp" />

  <TextView
    android:id="@+id/finance_widget_spent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:textColor="#FFFFFFFF"
    android:textSize="26sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/finance_widget_outlook"
    android:layout_width="wrap_content"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:maxLines="3"
    android:textColor="#B3FFFFFF"
    android:textSize="12sp" />

  <TextView
    android:id="@+id/finance_widget_add"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/finance_widget_button"
    android:paddingHorizontal="12dp"
    android:paddingVertical="5dp"
    android:text="+ Add"
    android:textColor="#FFFFFFFF"
    android:textSize="13sp"
    android:textStyle="bold" />
</LinearLayout>
